<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ cloud backup and device-to-device transfer.
     The Room database and DataStore preferences are included so a user's
     habits survive a phone migration. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
